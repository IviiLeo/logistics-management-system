{
  "expo": {
    "name": "APP",
    "slug": "APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/app/icono-app.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "package": "com.tuusuario.app",
      "adaptiveIcon": {
        "backgroundColor": "#EE6318",
        "foregroundImage": "./assets/images/logo/app/icono-android-frente.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6EC",
          "image": "./assets/images/logo/01-isotipo-solo.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
